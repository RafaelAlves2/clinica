# Bloquear o acesso HTTP aos metadados de controlo de versões.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(git|svn|hg)(/|$) - [F,NC,L]
</IfModule>

# Bloquear acesso a ficheiros sensiveis
<FilesMatch "(?i)\.(sql|sqlite|db|bak|old|orig|log|ini|env|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Proteger configuracao/controlo e documentacao interna sensivel
<FilesMatch "(?i)^(\.git|\.gitignore|\.htaccess|README\.md|\.env\.example|composer\.(json|lock)|package(-lock)?\.json|RELATORIO-AUDITORIA\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
